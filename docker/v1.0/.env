# BLB Docker environment — v1.0
# Edit values here; they are injected into docker-compose.yml

# Port used for the two-party MPC protocol
BLB_PORT=1234

# Address the client uses to reach the server.
# Inside docker-compose networking this is the service name.
# When running standalone (single container) keep it as 127.0.0.1.
BLB_SERVER_IP=127.0.0.1

# Number of parallel build jobs (0 = auto via nproc)
BUILD_JOBS=0

# Per-test timeout in seconds (0 = no timeout)
TEST_TIMEOUT=2400

# Image tag
IMAGE_TAG=blb:v1.0
